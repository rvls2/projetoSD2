module ula(
    input wire [3:0] opcode,     // Opcode (4 bits)
    input wire [3:0] src1,       // Registrador 1 (4 bits)
    input wire [3:0] src2,       // Registrador 2 (4 bits)
    input wire [5:0] imm,        // Imediato (6 bits)
    input wire clk,              // Clock
    input wire reset,            // Reset
    output reg [15:0] result,    // Resultado  (16 bits)
    output reg zero,             // Sinalizador de zero
    output reg [7:0] display     // Display 
);

// Parametros:
parameter  LOAD = 3'b000, ADD = 3'b001, ADDI = 3'b010, SUB = 3'b011, SUBI = 3'b100, MUL = 3'b101, CLEAR = 3'b110, DISPLAY = 3'b111;

reg [15:0] registers [0:15]; // 16 registradores de 16 bits

initial begin
    registers[0]  = 16'b0;
    registers[1]  = 16'b0;
    registers[2]  = 16'b0;
    registers[3]  = 16'b0;
    registers[4]  = 16'b0;
    registers[5]  = 16'b0;
    registers[6]  = 16'b0;
    registers[7]  = 16'b0;
    registers[8]  = 16'b0;
    registers[9]  = 16'b0;
    registers[10] = 16'b0;
    registers[11] = 16'b0;
    registers[12] = 16'b0;
    registers[13] = 16'b0;
    registers[14] = 16'b0;
    registers[15] = 16'b0;
    result = 16'b0;
    zero = 0;
end

always @(posedge clk or posedge reset) begin
    if (reset) begin
        // Zerando todos os registradores
        registers[0] <= 16'b0;
        registers[1] <= 16'b0;
        registers[2] <= 16'b0;
        registers[3] <= 16'b0;
        registers[4] <= 16'b0;
        registers[5] <= 16'b0;
        registers[6] <= 16'b0;
        registers[7] <= 16'b0;
        registers[8] <= 16'b0;
        registers[9] <= 16'b0;
        registers[10] <= 16'b0;
        registers[11] <= 16'b0;
        registers[12] <= 16'b0;
        registers[13] <= 16'b0;
        registers[14] <= 16'b0;
        registers[15] <= 16'b0;
        result <= 16'b0;
        zero <= 0;
    end else begin
        case (opcode)
            ADD: begin
                result <= registers[src2] + registers[src1]; // Soma
                registers[src1] <= result; // Armazena no registrador de destino
            end
            SUB: begin
                result <= registers[src2] - registers[src1];
                registers[src1] <= result;
            end
            ADDI: begin
                if (imm[5] == 1) begin
                    result <= registers[src2] - imm[5:0];
                end else begin
                    result <= registers[src2] + imm[5:0];
                end
                registers[src1] <= result;
            end
            SUBI: begin
                if (imm[5] == 1) begin
                    result <= registers[src2] + imm[5:0];
                end else begin
                    result <= registers[src2] - imm[5:0];
                end
                registers[src1] <= result;
            end
            MUL: begin
                if (imm[5] == 1) begin
                    result <= registers[src2] * imm[5:0];
                    result = result * -1;
                end else begin
                    result <= registers[src2] * imm[5:0];
                end
                registers[src1] <= result;
            end
            LOAD: begin
                result <= imm;
                registers[src1] <= result;
            end
            CLEAR: begin
                // Zera todos os registradores
                registers[0] <= 16'b0;
                registers[1] <= 16'b0;
                registers[2] <= 16'b0;
                registers[3] <= 16'b0;
                registers[4] <= 16'b0;
                registers[5] <= 16'b0;
                registers[6] <= 16'b0;
                registers[7] <= 16'b0;
                registers[8] <= 16'b0;
                registers[9] <= 16'b0;
                registers[10] <= 16'b0;
                registers[11] <= 16'b0;
                registers[12] <= 16'b0;
                registers[13] <= 16'b0;
                registers[14] <= 16'b0;
                registers[15] <= 16'b0;
            end
            DISPLAY: begin
                display <= registers[src1];
            end
            default: begin
                result <= 16'b0;
            end
        endcase
        // Verificação do sinalizador de zero
        zero <= (result == 16'b0) ? 1'b1 : 1'b0; //desconsidera isso,só uma flag normal
    end
end

endmodule
